{
  "name": "sableye-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "predev": "pnpm run build:sdk",
    "dev": "next dev",
    "prebuild": "pnpm run build:sdk",
    "build:sdk": "pnpm --filter sableye-frontend^... run build",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "check:render": "node scripts/check-render.mjs",
    "check:serverless-invoice": "node --conditions=react-server --test scripts/check-serverless-invoice.mjs",
    "dev:clean": "pkill -f \"next dev\" || true; rm -rf .next; next dev",
    "check:navbar": "node scripts/check-navbar.mjs",
    "check:books": "node --test scripts/check-books-independent.mjs"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@base-ui/react": "^1.9.0",
    "@lucasmarkes/hairline": "0.5.1",
    "@sableye/core": "workspace:*",
    "@sableye/react": "workspace:*",
    "@sableye/server": "workspace:*",
    "@walletconnect/universal-provider": "^2.26.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "ogl": "1.0.11",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "^0.3.2",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.57.16",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@types/prismjs": "^1.26.5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
