# Signs invoices. Server only: never prefix it with NEXT_PUBLIC_, and never commit .env.
# Use a fresh testnet key. Signing costs no gas. Payments go to this address unless you set `payout`.
MERCHANT_KEY=0x...

# Optional. Your own PaymentProcessor deployment; leave empty to use the official one.
NEXT_PUBLIC_SABLEYE_PROCESSOR=

# Optional. Defaults to the public Whitechain RPC.
SABLEYE_RPC_URL=
NEXT_PUBLIC_SABLEYE_RPC_URL=

# Set this when you deploy, so payment links point at your site. Defaults to http://localhost:3000/pay.
SABLEYE_CHECKOUT_URL=

# --- Business and email (optional; `npx sableye init --email` sets these up and sends a test email) ---
# Shown on invoices, receipts and emails.
SABLEYE_BUSINESS_NAME=
# Your email login. Gmail needs an app password: https://myaccount.google.com/apppasswords
# The SMTP server is detected for Gmail, Outlook, Yahoo, Zoho and iCloud; set SABLEYE_SMTP_HOST/SABLEYE_SMTP_PORT for others.
SABLEYE_SMTP_USER=
SABLEYE_SMTP_PASS=
SABLEYE_SMTP_HOST=
SABLEYE_SMTP_PORT=
# Where "you got paid" notices go (default: SABLEYE_SMTP_USER). "off" turns them off.
MERCHANT_EMAIL=

# --- Arkiv (optional): publish paid invoices as records owned by your merchant wallet ---
# Free access key: https://hub.arkiv.network/access-keys · test tGLM for the same address: https://hub.arkiv.network/faucet
ARKIV_ACCESS_KEY=
