# Signs invoices. Server only: never prefix it with NEXT_PUBLIC_, and never commit .env.
# Use a fresh testnet key. Signing costs no gas. Payments go to this address unless you set `payout`.
MERCHANT_KEY=0x...

# Optional. Your own PaymentProcessor deployment; leave empty to use the official one.
NEXT_PUBLIC_SABLEYE_PROCESSOR=

# Optional. Defaults to the public Whitechain RPC.
SABLEYE_RPC_URL=
NEXT_PUBLIC_SABLEYE_RPC_URL=

# Set this when you deploy, so payment links point at your site. Defaults to http://localhost:3000/pay.
SABLEYE_CHECKOUT_URL=
