# Sandbox and SDK settings. The frontend reads this repo-root .env at build and run time; `npx sableye init` fills it in.

# The canonical origin of the deployed site, with no trailing slash.
# Metadata, canonical URLs, sitemap.xml and robots.txt all read it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for the interactive sandbox APIs. Server-only; use a testnet wallet.
# Set this in the hosting environment as well as locally. Never use NEXT_PUBLIC_.
MERCHANT_KEY=

# --- Business and email (optional; `npx sableye init --email` sets these up and sends a test email) ---
# Shown on invoices, receipts and emails.
SABLEYE_BUSINESS_NAME=
# Your email login. Gmail needs an app password: https://myaccount.google.com/apppasswords
# The SMTP server is detected for Gmail, Outlook, Yahoo, Zoho and iCloud; set SMTP_HOST/SMTP_PORT for others.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
# Where "you got paid" notices go (default: SMTP_USER). "off" turns them off.
MERCHANT_EMAIL=

# --- Arkiv (optional): publish paid invoices as records owned by your merchant wallet ---
# Free access key: https://hub.arkiv.network/access-keys · test tGLM for the same address: https://hub.arkiv.network/faucet
ARKIV_ACCESS_KEY=

# Optional: WalletConnect (Whitewallet and any mobile wallet) in the checkout. Free project id: https://cloud.reown.com
# Add your site (and localhost) to the project's allowed domains. It is public, not a secret.
NEXT_PUBLIC_REOWN_PROJECT_ID=
