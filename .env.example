# Merchant wallet key. Testnet only. It needs a little WBT for gasless checkouts and refunds.
MERCHANT_KEY=0x...

# Demo store. See docs/DEMO.md.
# Password for /admin. The dashboard stays locked until this is set.
ADMIN_PASSWORD=
# Public URL for emailed links and QR codes, e.g. your tunnel. Defaults to http://localhost:3000.
PUBLIC_URL=
# Gmail address and app password. Without them, emails are logged on /admin but not delivered.
SMTP_USER=
SMTP_PASS=
# Where "you got paid" notices go. Defaults to SMTP_USER.
MERCHANT_EMAIL=

# Phase 2
ARKIV_RPC=https://rpc.rabdi.db-chain.testnet.arkiv.network
